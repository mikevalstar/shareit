{
  "name": "shareit",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n css,app -c magenta,cyan \"bun run css:dev\" \"bun run --hot src/index.tsx\"",
    "start": "bun run src/index.tsx",
    "build": "bun run css:build",
    "css:dev": "tailwindcss -i ./src/styles/app.css -o ./public/app.css --watch",
    "css:build": "tailwindcss -i ./src/styles/app.css -o ./public/app.css --minify",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "hash-password": "bun run src/scripts/hash-password.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.3.14",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.33",
    "lucide-static": "^1.28.0",
    "nanoid": "^6.0.0",
    "shiki": "^4.4.1",
    "zod": "^4.4.3"
  }
}
